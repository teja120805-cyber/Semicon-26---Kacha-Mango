# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/

# Generated datasets (reproducible from seed via generator/dataset_generator.py -
# see README "Reproducibility" section - never commit generated PNGs/manifests blindly)
data/development/*
data/validation/*
data/held_out/*
data/challenge/*
data/cross_generator/*
!data/*/.gitkeep

# Trained model checkpoints (reproducible via model/train.py + TRAINING_PROTOCOL.md)
model/checkpoints/*
!model/checkpoints/.gitkeep

# Generated benchmark artifacts (reproducible via evaluation/*.py).
#
# The problem statement lists "Results" (metrics, plots, runtime, failure case)
# and a "CSV/manifest" among the REQUIRED submission deliverables, so the eight
# benchmark figures, the metric JSONs and the per-pair manifest ARE tracked: an
# evaluator who clones this repository has to be able to read the results
# without first regenerating a 156-pair dataset. They stay reproducible - see
# README "Reproducibility" - but reproducible is not the same as present.
#
# Everything else under outputs/ is intermediate and stays ignored: the learned
# re-ranker's parallel result set, the pre-PSF baseline snapshot, and any
# scratch verification directories.
outputs/plots/*
!outputs/plots/.gitkeep
!outputs/plots/*.png

outputs/reports/*
!outputs/reports/.gitkeep
!outputs/reports/baseline_metrics.json
!outputs/reports/failure_analysis_cases.json
!outputs/reports/per_pair_results.csv
!outputs/reports/per_pair_results.json

outputs/visualizations/*
!outputs/visualizations/.gitkeep

# Experiment outputs (each experiment's own generated artifacts)
experiments/*/outputs/
experiments/*/checkpoints/
experiments/*/data/
experiments/*/data_b/
experiments/*/*_data/

# Local backup from a dataset-regeneration verification pass - not source,
# not meant to be pushed (external/ IS tracked - it's the real cross-generator
# eval-surface source, kept intentionally).
data_backup_pre_integration/

# Office lock/temp files (created while a .docx/.xlsx/.pptx is open; never real content)
~$*

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
.claude/
